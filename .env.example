# FBL Forms Environment Variables
# Copy this to .env.local for local development (never commit .env files!)

# Resend API Key (get from https://resend.com/api-keys)
# This must be configured in Vercel environment variables for production
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Form recipient email - ALL submissions go to this address
# User confirmed: Both membership and partner applications → member@fblconnect.com
MEMBERSHIP_FORM_RECIPIENT_EMAIL=member@fblconnect.com
PARTNER_FORM_RECIPIENT_EMAIL=member@fblconnect.com

# Optional: General fallback recipient (if form-specific emails not set)
FORM_RECIPIENT_EMAIL=member@fblconnect.com

# Optional: Rate limiting (default: 3 submissions per hour per IP)
# RATE_LIMIT_MAX=3

# Optional: Allowed origins for CORS (comma-separated, no trailing slashes)
# ALLOWED_ORIGINS=https://fblconnect.com,https://wilsontechconsulting-png.github.io
